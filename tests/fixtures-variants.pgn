[Site "https://en.wikipedia.org/wiki/Grand_Chess"]
[Date "2001.??.??"]
[Round "Final"]
[White "John Vehre"]
[Black "R. Wayne Schmittberger"]
[Result "1-0"]
[Variant "Grand"]
[SetUp "1"]
[FEN "rnbqkcanrj/pppppppppp/10/10/10/10/PPPPPPPPPP/RNBQKCANRJ w - - 0 1"]

1.f5 f6 2.Nh4 Nh7 3.g4 g7 4.Nc4 Nc7 5.d4 d7 6.e5 Bd8
7.Rje1 Kd10 8.Kf1 fxe5 9.Ncxe5 Kc9 10.Re2 Kb9 11.Kg1 Rjf10
12.Bd3 e6 13.Rf1 Mh10 14.Nc4 Ci10 15.Nd6 exf5 16.Bxf5 Bd5
17.Ci1 Bxh4 18.ixh4 g6 19.Rfe1 gxf5 20.Nxf5 Qd8 21.Bxc7 Qxc7
22.Re9+ Kc10 23.Cxc7 bxc7 24.Qf4 d6 25.Qe3 Mg8 26.Me2 Nf6
27.Qe7 Nd7 28.Qe8+ Mxe8 29.Mxe8 1-0

